rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid} — each farmer's own profile: points, level, progress.
    // Anyone signed in can READ any profile (needed for the leaderboard),
    // but a user can only WRITE their own document, and only touch
    // fields the app actually uses (no arbitrary field injection).
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['points', 'level', 'farmSizeAcres', 'quizzesCompleted',
                                   'topicsCompleted', 'lessonsCompleted', 'badges',
                                   'daysActive', 'lastActiveDate', 'name']);
      allow delete: if false;
    }

    // posts/{postId} — community feed. Anyone signed in can read/create.
    // Only the post's author can edit the body; anyone signed in can
    // like (the arrayUnion update only ever touches likeUids).
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && (
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeUids'])
                         || resource.data.uid == request.auth.uid
                       );
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
