
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================
    // USERS: Profile, points, level and progress
    // =========================================
    match /users/{userId} {

      // Signed-in users can read profiles for the leaderboard.
      allow read: if request.auth != null;

      // Users can create only their own profile.
      allow create: if request.auth != null
                    && request.auth.uid == userId;

      // Users can update only their own profile
      // and approved GreenGrow fields.
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly([
                           'points',
                           'level',
                           'farmSizeAcres',
                           'quizzesCompleted',
                           'topicsCompleted',
                           'lessonsCompleted',
                           'badges',
                           'daysActive',
                           'lastActiveDate',
                           'name',
                           'uid',
                           'email',
                           'mobile',
                           'language',
                           'village',
                           'district',
                           'state',
                           'photoURL',
                           'updatedAt'
                         ]);

      // Profile deletion is disabled.
      allow delete: if false;
    }

    // =========================================
    // COMMUNITY POSTS
    // =========================================
    match /posts/{postId} {

      // Signed-in users can read posts.
      allow read: if request.auth != null;

      // Users can create posts only under their own UID.
      allow create: if request.auth != null
                    && request.resource.data.uid
                       == request.auth.uid;

      // Users can update likes, or edit their own posts.
      allow update: if request.auth != null
                    && (
                      request.resource.data.diff(resource.data)
                        .affectedKeys()
                        .hasOnly(['likeUids'])
                      || resource.data.uid == request.auth.uid
                    );

      // Only the author can delete their post.
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    // =========================================
    // FEEDBACK: Ratings and comments
    // =========================================
    match /feedback/{feedbackId} {

      // Users can submit feedback only for themselves.
      allow create: if request.auth != null
                    && request.resource.data.uid
                       == request.auth.uid
                    && request.resource.data.keys().hasAll([
                         'uid',
                         'userName',
                         'rating',
                         'comment',
                         'createdAt'
                       ])
                    && request.resource.data.keys().hasOnly([
                         'uid',
                         'userName',
                         'rating',
                         'comment',
                         'createdAt'
                       ])
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.comment is string
                    && request.resource.data.comment.size() > 0
                    && request.resource.data.comment.size() <= 1000
                    && request.resource.data.userName is string
                    && request.resource.data.createdAt == request.time;

      // Users can read only their own feedback.
      allow read: if request.auth != null
                  && resource.data.uid == request.auth.uid;

      // Feedback cannot be edited or deleted by clients.
      allow update, delete: if false;
    }
  }
}
